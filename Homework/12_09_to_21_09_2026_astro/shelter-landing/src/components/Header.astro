---
// Header.astro
---
<header class="header">
    <div class="logo">
        <strong>Вухаті друзі</strong>
    </div>
    <nav class="nav">
        <a href="#home">Головна</a>
        <a href="#pets">Підопічні</a>
        <a href="#contacts">Контакти</a>
    </nav>
</header>

<style>
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
        background-color: #ffffff;
        border-bottom: 1px solid #eaeaea;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.2rem;
    }

    .nav {
        display: flex;
        gap: 20px;
    }

    .nav a {
        text-decoration: none;
        color: #333;
        font-size: 0.95rem;
        transition: color 0.2s;
    }

    .nav a:hover {
        color: #ff5733;
    }
</style>