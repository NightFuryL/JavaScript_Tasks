---
const { title, description } = Astro.props;
---

<div class="card">
    <h3>{title}</h3>
    <p>{description}</p>
</div>

<style>
    .card {
        background-color: #2a2a2a;
        padding: 24px;
        border-radius: 8px;
        border: 1px solid #333;
        flex: 1;
        min-width: 280px;
    }
    h3 {
        color: #fff;
        margin-top: 0;
    }
    p {
        color: #ccc;
        line-height: 1.5;
    }
</style>